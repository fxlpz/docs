# ============================================================
# KernelDocs - exemplo de configuração (SEM SEGREDOS)
# Copie para .env e ajuste. Nunca versione o arquivo .env real.
#   cp .env.example .env
# ============================================================

# Ambiente: development | test | production
NODE_ENV=development

# API - por padrão escuta apenas em 127.0.0.1 (não expor à internet sem aprovação)
HOST=127.0.0.1
PORT=3000

# Web (Vite) - padrão 127.0.0.1. Para abrir no PC da equipe pela LAN (rede interna),
# defina 0.0.0.0 e acesse http://<ip-do-servidor>:5173
# A API continua em 127.0.0.1: o navegador fala apenas com o Vite (proxy /api).
# NÃO usar 0.0.0.0 exposto à internet sem aprovação + HTTPS (Etapa 4).
# WEB_HOST=0.0.0.0

# Porta da Web em desenvolvimento (padrão 5173). Se a rede bloquear a porta,
# defina uma porta liberada pela ACL (testar: Test-NetConnection <ip> -Port <n>).
# WEB_PORT=5173

# Nível de log: fatal | error | warn | info | debug | trace | silent
# Nunca suba para "debug"/"trace" em produção sem aprovação (risco de logar dados sensíveis)
LOG_LEVEL=info

# Diretório próprio de dados (banco SQLite + anexos), separado do código.
# Caminho relativo é resolvido a partir da raiz de apps/api. Crie e proteja o diretório
# fora da árvore de código na implantação (ex.: /home/kernel-adm/krndocs-data).
DATA_DIR=var

# ---- Definidos a partir da Etapa 2 (autenticação) ----
# Segredo mínimo de 32 caracteres para assinatura de cookies de sessão.
# Gerar: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Obrigatório quando NODE_ENV=production.
# SESSION_SECRET=

# Só defina como true atrás de HTTPS (produção com TLS aprovado).
# COOKIE_SECURE=false

# Senha provisória dos administradores no primeiro provisionamento.
# Usada SOMENTE por `npm run provision` (e `--reset`): nasce provisória e o
# 1º login exige a troca. Defina no .env real (nunca versionado) e REMOVA
# após o provisionamento. Mínimo: 10 caracteres.
# KD_BOOTSTRAP_PASSWORD=

# ---- Futuro (Etapa 4 - aprovação necessária) ----
# Endereço/URL público atrás de proxy reverso (quando existir)
# PUBLIC_ORIGIN=http://172.16.16.36:3000
